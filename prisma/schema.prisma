generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model indexedChunk {
  id             String   @id @default(cuid())
  chunkId        String   @unique
  summary        String
  bullets        String?
  canonicalTitle String
  tags           String?
  metadata       String?
  source         String
  sourceType     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([canonicalTitle, chunkId, source])
}

